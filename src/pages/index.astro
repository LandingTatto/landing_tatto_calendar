---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Gallery from "../components/Gallery.astro";
import Materials from "../components/Materials.astro";
import InfoInteractive from "../components/InfoInteractive.astro";
---

<Layout title="Daniel | Body Modification">
	<Header />

	<main class="mx-auto max-w-7xl px-6">
		<Hero />
		<div class="section-divider" aria-hidden="true"></div>
		<Materials />
		<div class="section-divider" aria-hidden="true"></div>
		<Gallery />
		<div class="section-divider" aria-hidden="true"></div>
		<InfoInteractive />
	</main>
</Layout>

<style>
	.section-divider {
		height: 1px;
		margin: 0 1rem;
		background: linear-gradient(90deg, transparent, rgba(56, 56, 60, 0.9) 18%, rgba(158, 108, 89, 0.35) 50%, rgba(56, 56, 60, 0.9) 82%, transparent);
	}
</style>
