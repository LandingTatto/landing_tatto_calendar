---
// Layout compartido por todas las páginas. El contenido concreto llega mediante
// <slot /> desde cada archivo ubicado en src/pages/.
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
}

// Cada página puede sobreescribir el título del documento; si no lo hace,
// usamos el nombre general de la marca.
const { title = "Daniel | Body Modification" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
	</head>

	<body>
		<!-- El layout envuelve el contenido de la página y añade el footer común. -->
		<slot />
		<Footer />
	</body>
</html>
