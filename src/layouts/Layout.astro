---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
}

const { title = "Daniel | Body Modification" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
	</head>

	<body>
		<slot />
		<Footer />
	</body>
</html>
