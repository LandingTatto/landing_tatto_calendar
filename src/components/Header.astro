---
// Enlaces internos de la navegación. Los anchors apuntan a IDs de las secciones
// de la home; Privacidad es la única ruta independiente.
const navLinks = [
    { label: "Inicio", href: "/#inicio" },
	{ label: "Calidad", href: "/#calidad" },
	{ label: "Galería", href: "/#galeria" },
	{ label: "Información", href: "/#informacion" },
	{ label: "Privacidad", href: "/privacidad" },
];

// En móvil usamos navegación directa porque el modal de Google Calendar no
// permite controlar bien su layout responsive desde nuestra landing.
const bookingUrl = "https://calendar.google.com/calendar/appointments/schedules/AcZssZ3dMF0eCPdqKP_fhAwTaK2TNZYiJsWJ-mkSOnlppVkJkm68R_xTWSZAqTHEYzm6KphgZ_1A-68M?gv=true";

---

<!-- Google Calendar aporta el botón oficial y el modal de reserva. -->
<link
    href="https://calendar.google.com/calendar/scheduling-button-script.css"
    rel="stylesheet"
/>
<script
    is:inline
    src="https://calendar.google.com/calendar/scheduling-button-script.js"
    async
></script>

<header class="sticky top-0 z-50 w-full border-b border-border/80 bg-background/90 backdrop-blur-md">
	<!-- La barra permanece visible mientras el visitante recorre la landing. -->
    <nav
        aria-label="Navegación principal"
        class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-6"
    >
        <a
            href="/#inicio"
            class="group shrink-0 rounded-sm focus-visible:outline-offset-4"
            aria-label="Daniel Body Modification, inicio"
        >
                <span class="block text-[1.15rem] font-semibold leading-none tracking-[0.18em] text-foreground transition-colors duration-200 group-hover:text-accent-hover sm:text-[1.35rem] sm:tracking-[0.2em]">
                DANIEL
            </span>

                <span class="mt-1 block text-[8px] font-medium leading-none tracking-[0.22em] text-muted transition-colors duration-200 group-hover:text-foreground sm:text-[9px] sm:tracking-[0.28em]">
                BODY MODIFICATION
            </span>
        </a>

        <ul class="hidden items-center gap-8 md:flex">
            {
                navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="group relative rounded-sm py-3 text-sm text-muted transition-colors duration-200 hover:text-foreground focus-visible:outline-offset-4"
                        >
                            {link.label}
                            <span class="absolute inset-x-0 bottom-1 h-px origin-left scale-x-0 bg-accent transition-transform duration-200 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100" aria-hidden="true"></span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="flex items-center gap-3">
            <span class="hidden items-center rounded-sm border border-accent/60 bg-accent/10 px-3 py-2 text-right text-[10px] font-semibold uppercase leading-tight tracking-[0.14em] text-accent-hover md:flex">
                Abono del 50%<br />para confirmar la hora
            </span>

            <!-- En pantallas muy pequeñas se oculta el botón para evitar overflow. -->
            <!-- En desktop mantenemos el botón oficial con modal de Google. -->
            <div class="calendar-button hidden md:block">
                <script is:inline>
                    (() => {
                        const target = document.currentScript;

                        window.addEventListener("load", () => {
                            calendar.schedulingButton.load({
                                url: "https://calendar.google.com/calendar/appointments/schedules/AcZssZ3dMF0eCPdqKP_fhAwTaK2TNZYiJsWJ-mkSOnlppVkJkm68R_xTWSZAqTHEYzm6KphgZ_1A-68M?gv=true",
                                color: "#F09300",
                                label: "Reservar una cita",
                                target,
                            });
                        });
                    })();
                </script>
            </div>

            <!-- En móvil Google Calendar se abre como página completa, evitando
                 el modal estrecho que no podemos estilizar desde este dominio. -->
            <a
                class="mobile-booking-button rounded-md bg-accent px-3 py-3 text-center text-[10px] font-semibold uppercase leading-tight tracking-[0.08em] text-black transition-colors hover:bg-accent-hover focus-visible:outline-offset-4 md:hidden"
                href={bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
            >
                Reservar<br />una cita
            </a>

            <!-- details/summary permite un menú móvil accesible sin depender de un framework. -->
            <details id="mobile-menu" class="relative md:hidden">
                <summary
                    class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-border text-muted transition-colors duration-200 hover:border-accent hover:text-foreground focus-visible:outline-offset-4 [&::-webkit-details-marker]:hidden"
                    aria-label="Abrir menú"
                    aria-controls="mobile-navigation"
                    aria-expanded="false"
                >
                    <span class="sr-only">Abrir menú</span>
                    <span class="menu-icon flex w-5 flex-col" aria-hidden="true">
                        <span class="menu-icon__line h-px w-full bg-current"></span>
                        <span class="menu-icon__line h-px w-full bg-current"></span>
                        <span class="menu-icon__line h-px w-full bg-current"></span>
                    </span>
                </summary>

                <div id="mobile-navigation" class="fixed inset-x-0 top-20 rounded-b-2xl border-b border-border bg-surface/98 px-5 py-4 shadow-2xl shadow-black/30">
                    <ul class="mx-auto flex max-w-7xl flex-col">
                        {
                            navLinks.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="block rounded-lg px-4 py-3 text-base text-muted transition-colors duration-200 hover:bg-surface-hover hover:text-foreground focus-visible:outline-offset-[-2px]"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>

                </div>
            </details>
        </div>
    </nav>
</header>

<script>
    // Sincroniza el estado nativo de <details> con atributos ARIA y las clases
    // que convierten las tres líneas del icono en una X.
    const mobileMenu = document.querySelector<HTMLDetailsElement>("#mobile-menu");

    if (mobileMenu) {
        const toggle = mobileMenu.querySelector<HTMLElement>("summary");
        const links = mobileMenu.querySelectorAll<HTMLAnchorElement>("a");

        const syncMenuState = () => {
            const isOpen = mobileMenu.open;

            mobileMenu.dataset.open = String(isOpen);
            toggle?.setAttribute("aria-expanded", String(isOpen));
            toggle?.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");

            const label = toggle?.querySelector(".sr-only");
            if (label) label.textContent = isOpen ? "Cerrar menú" : "Abrir menú";
        };

        mobileMenu.addEventListener("toggle", syncMenuState);

        links.forEach((link) => {
            link.addEventListener("click", () => {
                mobileMenu.open = false;
            });
        });

        // Cerrar el menú al hacer clic fuera de él mejora la navegación móvil.
        document.addEventListener("click", (event) => {
            if (mobileMenu.open && !mobileMenu.contains(event.target as Node)) {
                mobileMenu.open = false;
            }
        });

        syncMenuState();
    }
</script>

<style>
    /* Estado visual del icono hamburguesa cuando el menú está abierto. */
    #mobile-menu[data-open="true"] .menu-icon__line:first-child {
        transform: rotate(45deg);
    }

    #mobile-menu[data-open="true"] .menu-icon__line:nth-child(2) {
        opacity: 0;
    }

    #mobile-menu[data-open="true"] .menu-icon__line:last-child {
        transform: rotate(-45deg);
    }

    .menu-icon__line {
        /* Separación necesaria para que el estado cerrado se lea como menú. */
        margin-block: 0.16rem;
        transition: transform 200ms ease, opacity 200ms ease;
    }

    @media (prefers-reduced-motion: reduce) {
        .menu-icon__line {
            transition: none;
        }
    }

    /* El botón oficial de Google tiene un tamaño generoso en desktop; este
       ajuste evita que domine el header cuando el viewport aún es reducido. */
    @media (min-width: 640px) and (max-width: 767px) {
        .calendar-button {
            transform: scale(0.88);
            transform-origin: right center;
            margin-left: -0.35rem;
        }
    }
</style>
